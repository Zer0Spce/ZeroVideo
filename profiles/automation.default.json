{
  "chatGpt": {
    "promptInputs": ["#prompt-textarea", "textarea[placeholder*='Ask']", "[contenteditable='true']"],
    "sendButtons": ["[data-testid='send-button']", "button[aria-label*='Send']"],
    "stopButtons": ["[data-testid='stop-button']", "button[aria-label*='Stop']"],
    "assistantMessages": ["[data-message-author-role='assistant']"]
  },
  "clipchamp": {
    "newVideoButtons": ["text=Create a new video", "text=New video", "button:has-text('Create')"],
    "recordCreateButtons": ["text=Record & create", "button:has-text('Record & create')"],
    "textToSpeechButtons": ["text=Text to speech", "button:has-text('Text to speech')"],
    "scriptInputs": ["textarea", "[contenteditable='true']"],
    "languageControls": ["button:has-text('Language')"],
    "voiceControls": ["button:has-text('Voice')"],
    "saveButtons": ["button:has-text('Save')"],
    "exportButtons": ["button:has-text('Export')"],
    "audioOnlyButtons": ["text=Audio only", "text=Audio-only"],
    "downloadButtons": ["text=Save to your computer", "text=Download"]
  }
}
