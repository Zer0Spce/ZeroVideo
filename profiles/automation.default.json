{
  "chatGpt": {
    "promptInputs": ["#prompt-textarea", "textarea[placeholder*='Ask']", "[contenteditable='true']"],
    "sendButtons": ["[data-testid='send-button']", "button[aria-label*='Send']"],
    "stopButtons": ["[data-testid='stop-button']", "button[aria-label*='Stop']", "button[data-testid*='stop']"],
    "assistantMessages": [
      "[data-message-author-role='assistant']",
      "main article[data-testid^='conversation-turn-']",
      "main [data-testid^='conversation-turn-']",
      "main .markdown",
      "main [class*='markdown']"
    ],
    "generatedImages": [
      "main img",
      "main figure img",
      "main article img",
      "main [data-testid^='conversation-turn-'] img",
      "[data-message-author-role='assistant'] img",
      "article[data-testid*='conversation-turn'] img"
    ]
  },
  "clipchamp": {
    "newVideoButtons": [
      "xpath=//*[normalize-space()='Text to speech']/ancestor::*[.//button[normalize-space()='Try it']][1]//button[normalize-space()='Try it']"
    ],
    "recordCreateButtons": [],
    "textToSpeechButtons": [
      "xpath=//*[normalize-space()='Text to speech']/ancestor::*[.//button[normalize-space()='Try it']][1]//button[normalize-space()='Try it']",
      "button:has-text('Text to speech')",
      "[aria-label*='Text to speech' i]",
      "text=Text to speech"
    ],
    "scriptInputs": ["textarea[placeholder*='Type what' i]", "[role='textbox'][aria-label*='Type what' i]", "textarea", "[contenteditable='true']"],
    "languageControls": ["button:has-text('English (United States)')", "[aria-label*='language' i]", "button:has-text('Language')"],
    "voiceControls": ["button:has-text('Multilingual')", "[role='combobox']:has-text('Multilingual')", "[aria-label*='voice' i]", "button:has-text('Voice')"],
    "saveButtons": ["button:has-text('Save')"],
    "exportButtons": ["button:has-text('Export')"],
    "audioOnlyButtons": ["text=Audio only", "text=Audio-only", "text=Audio-only Only the audio from your project"],
    "finalExportButtons": ["[role='dialog'] button:has-text('Export')", "div[role='dialog'] button:has-text('Export')", "button:has-text('Export')"],
    "downloadButtons": ["text=Save to your computer", "text=Download", "button:has-text('Download')"]
  }
}
