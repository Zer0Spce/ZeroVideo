<Window x:Class="ZeroVideo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZeroVideo" Width="1320" Height="900" MinWidth="1100" MinHeight="820" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
  <Grid x:Name="RootShell" Margin="22" Background="{StaticResource Bg}" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform Y="14"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16" Background="{StaticResource Bg}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="ZERO" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentHover}"/>
          <TextBlock Text="VIDEO" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Text}"/>
          <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,3" Margin="10,5,0,5"><TextBlock Text="WINDOWS" Foreground="#C4B5FD" FontSize="10" FontWeight="SemiBold"/></Border>
        </StackPanel>
        <TextBlock Text="Long-form AI video production studio" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadProjectCommand}" Content="Load project"/>
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenProjectFolderCommand}" Content="Open folder"/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="Create">
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="New long-form video" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Label Content="TOPIC"/><TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True"/>

              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="LENGTH (MIN)"/><ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding Duration, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose the target video length."/></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="FORMAT"/><ComboBox ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding AspectRatio}"/></StackPanel>
              </Grid>

              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Label Content="STORY / EDIT STYLE"/>
                  <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose a visual/edit style."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Label Content="CLIPCHAMP VOICE"/>
                  <ComboBox ItemsSource="{Binding ClipchampVoices}" SelectedItem="{Binding Project.Voice, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose the Clipchamp TTS voice for this project."/>
                </StackPanel>
              </Grid>

              <Separator Margin="0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="New Chat" IsChecked="{Binding NewChat}" ToolTip="One-shot: start a fresh project chat on the next ChatGPT action."/>
              </Grid>

              <TextBlock Text="Output options" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,1"/>
              <CheckBox Content="Generate missing visuals with ChatGPT" IsChecked="{Binding Project.Options.GenerateMissingVisuals}"/>

              <Border Background="#17151F" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="18,2,0,7">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="How Many Chapters" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.HowManyChapters, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Images Per Chapter" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.ImagesPerChapter, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Safety Total Image Cap" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.MaxGeneratedVisuals, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>

              <WrapPanel Margin="0,0,0,2">
                <CheckBox Content=".SRT captions" IsChecked="{Binding Project.Options.GenerateCaptions}" Margin="0,4,15,4"/>
                <CheckBox Content="Visual motion" IsChecked="{Binding Project.Options.AddMotion}" Margin="0,4,15,4"/>
                <CheckBox Content="Music" IsChecked="{Binding Project.Options.AddBackgroundMusic}" Margin="0,4,15,4"/>
                <CheckBox Content="SFX hooks" IsChecked="{Binding Project.Options.AddSoundEffects}" Margin="0,4,0,4"/>
              </WrapPanel>

              <TextBlock Text="Each chapter is scripted into the requested number of narration/image scenes. Missing media reuses the nearest real visual — no black empty frames." Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <WrapPanel><Button Style="{StaticResource PrimaryButton}" Command="{Binding GeneratePlanCommand}" Content="1. Generate project"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding ContinueWritingCommand}" Content="Resume writing"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding RunPipelineCommand}" Content="2. Build video"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueTtsCommand}" Content="Continue TTS" IsEnabled="{Binding WaitingForTtsContinue}" ToolTip="Choose your voice manually in Clipchamp, then click here to continue narration and export."/></WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Project plan" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Every completed chapter is saved immediately. ZeroVideo also saves the project's ChatGPT conversation and returns to the same chat after restart." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Chapters}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/><DataGridTextColumn Header="Chapter" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="3*"/><DataGridTextColumn Header="Seconds" Binding="{Binding TargetSeconds}" Width="75"/><DataGridTextColumn Header="Scenes" Binding="{Binding Scenes.Count}" Width="65"/></DataGrid.Columns>
              </DataGrid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Automation Shorts">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Automation Shorts" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Paste a link or idea into each row. Videos run sequentially using the existing Create pipeline, including its manual Clipchamp voice confirmation." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddShortRowCommand}" Content="+ Add row"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveShortRowCommand}" Content="Remove last row"/>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartShortsCommand}" Content="Start automation"/>
                </WrapPanel>
              </StackPanel>
              <DataGrid ItemsSource="{Binding ShortQueue}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Link / text idea" Binding="{Binding Idea, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Shorts settings" FontSize="21" FontWeight="SemiBold"/>
                <Label Content="VIDEO LENGTH (MIN)" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding ShortDurations}" SelectedItem="{Binding ShortDuration, Mode=TwoWay}"/>
                <TextBlock Text="Format: 9:16 vertical" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Label Content="STORY / EDIT STYLE" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}"/>
                <Label Content="CLIPCHAMP VOICE" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding ClipchampVoices}" SelectedItem="{Binding Project.Voice, Mode=TwoWay}"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Output options" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox Content="Generate missing visuals with ChatGPT" IsChecked="{Binding Project.Options.GenerateMissingVisuals}" Margin="0,7,0,0"/>
                <Label Content="HOW MANY CHAPTERS"/>
                <TextBox Text="{Binding Project.Options.HowManyChapters, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="IMAGES PER CHAPTER"/>
                <TextBox Text="{Binding Project.Options.ImagesPerChapter, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="SAFETY TOTAL IMAGE CAP"/>
                <TextBox Text="{Binding Project.Options.MaxGeneratedVisuals, UpdateSourceTrigger=LostFocus}"/>
                <CheckBox Content=".SRT captions" IsChecked="{Binding Project.Options.GenerateCaptions}" Margin="0,8,0,0"/>
                <CheckBox Content="Visual motion" IsChecked="{Binding Project.Options.AddMotion}"/>
                <CheckBox Content="Music" IsChecked="{Binding Project.Options.AddBackgroundMusic}"/>
                <CheckBox Content="SFX hooks" IsChecked="{Binding Project.Options.AddSoundEffects}"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ContinueTtsCommand}" Content="Continue TTS" IsEnabled="{Binding WaitingForTtsContinue}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Thumbnail" FontWeight="SemiBold"/>
                <TextBlock Text="Creates a title-specific vertical cover saved as thumbnail.png in each project folder." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Publishing" FontWeight="SemiBold"/>
                <TextBlock Text="YouTube / TikTok automatic posting and scheduling are not enabled yet; account authorization and platform integration are required." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Idea Generation">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="Idea Generation" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Generate compelling video titles and opening hooks for any niche. Ideas aim for curiosity and retention, not guaranteed views." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
              <Label Content="NICHE"/>
              <TextBox Text="{Binding IdeaNiche, UpdateSourceTrigger=PropertyChanged}" ToolTip="Examples: Horror, True Crime, History, Science, Space"/>
              <Label Content="NUMBER OF IDEAS" Margin="0,10,0,0"/>
              <TextBox Text="{Binding IdeaCount, UpdateSourceTrigger=LostFocus}"/>
              <Button Style="{StaticResource PrimaryButton}" Content="Generate video ideas" Command="{Binding GenerateIdeasCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
              <TextBlock Text="{Binding IdeaStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
              <Separator Margin="0,14"/>
              <TextBlock Text="Select an idea from the list, then add it to your Shorts queue or copy it into Create." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Button Style="{StaticResource PrimaryButton}" Content="+ Add selected to Shorts queue" Command="{Binding QueueSelectedIdeaCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
              <Button Style="{StaticResource SecondaryButton}" Content="Use selected idea in Create" Command="{Binding UseSelectedIdeaCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Generated ideas — title and hook" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <DataGrid ItemsSource="{Binding GeneratedIdeas}" SelectedItem="{Binding SelectedIdea, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Video title" Binding="{Binding Title}" Width="2*"/>
                  <DataGridTextColumn Header="Opening hook" Binding="{Binding Hook}" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Effects">
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="Visual Effects Engine" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Keep still images alive for their entire on-screen duration and automatically vary motion so long videos do not feel repetitive." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/>

              <CheckBox Content="Visual Motion" IsChecked="{Binding Project.Options.AddMotion}"/>
              <CheckBox Content="Continuous Scene Motion" IsChecked="{Binding Project.Options.ContinuousMotion}" ToolTip="Loop smooth motion for the entire time a still image remains on screen."/>
              <Grid Margin="18,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <TextBlock Text="Motion changes every" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="65" Text="{Binding Project.Options.MotionCycleSeconds, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/><TextBlock Text=" sec" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
              </Grid>
              <Label Content="MOTION STYLE" Margin="0,10,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.MotionStyle, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Cinematic"/><ComboBoxItem Content="Documentary"/><ComboBoxItem Content="Dynamic"/><ComboBoxItem Content="Minimal"/><ComboBoxItem Content="None"/>
              </ComboBox>

              <Separator Margin="0,14"/>
              <CheckBox Content="Scene Transitions" IsChecked="{Binding Project.Options.SceneTransitions}"/>
              <Label Content="TRANSITION STYLE" Margin="0,8,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.TransitionStyle, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Crossfade"/><ComboBoxItem Content="Fade Black"/><ComboBoxItem Content="Fade White"/><ComboBoxItem Content="Slide"/><ComboBoxItem Content="Push"/><ComboBoxItem Content="Zoom"/><ComboBoxItem Content="Blur"/><ComboBoxItem Content="Paper Swipe"/><ComboBoxItem Content="Marker Wipe"/><ComboBoxItem Content="None"/>
              </ComboBox>
            </StackPanel></ScrollViewer>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="Cinematic treatment" FontSize="21" FontWeight="SemiBold"/>
              <CheckBox Content="Cinematic Effects" IsChecked="{Binding Project.Options.CinematicEffects}" Margin="0,10,0,0"/>
              <CheckBox Content="Style-aware Effects" IsChecked="{Binding Project.Options.StyleAwareEffects}" ToolTip="Documentary, mystery, history, VOX, cartoon, stickman and whiteboard styles receive different treatments."/>
              <Label Content="EFFECT INTENSITY" Margin="0,8,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.EffectIntensity, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Subtle"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Strong"/>
              </ComboBox>

              <Separator Margin="0,14"/>
              <CheckBox Content="Smart Parallax (Beta)" IsChecked="{Binding Project.Options.SmartParallax}"/>
              <TextBlock Text="Creates a soft foreground layer plus an enlarged background layer, then moves them at different speeds with a slow camera push. Best on images with a clear central subject." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="18,2,0,10"/>

              <CheckBox Content="Avoid Repeating Effects" IsChecked="{Binding Project.Options.AvoidRepeatedEffects}"/>
              <TextBlock Text="ZeroVideo remembers recent motion and transition choices across chapters, avoiding sequences such as zoom → zoom → zoom. Automatic mode rotates push, pan, drift, static, pull-back and parallax." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="18,2,0,0"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Automation">
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Browser sessions" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Open ChatGPT or Clipchamp to sign in normally in the dedicated ZeroVideo Edge profile. Generation automatically hands that signed-in profile over to automation." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenChatGptCommand}" Content="Open ChatGPT"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenClipchampCommand}" Content="Open Clipchamp"/></WrapPanel><Button Style="{StaticResource SecondaryButton}" Command="{Binding RunPreflightCommand}" Content="Run system checks" HorizontalAlignment="Left" Margin="0,14,0,6"/><ListBox ItemsSource="{Binding PreflightLines}" Height="190" FontFamily="Consolas" FontSize="12"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Automation profile" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Selectors are stored outside the code so ChatGPT/Clipchamp UI changes can be repaired without rebuilding the entire app." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/><Label Content="PROFILE PATH"/><TextBox Text="{Binding Settings.AutomationProfilePath}"/><Label Content="EDGE PROFILE DIRECTORY" Margin="0,10,0,0"/><TextBox Text="{Binding Settings.EdgeUserDataDirectory}"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" Content="Save automation settings" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
        </Grid>
      </TabItem>

      <TabItem Header="Publishing">
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <Grid Margin="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
            
              <TextBlock Text="Finished Video Queue" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Finished Create and Automation Shorts videos appear here with their thumbnails and SEO metadata." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>
            <ListBox Grid.Row="1" MinHeight="100" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding PublishingQueue}" SelectedItem="{Binding SelectedPublishItem}" Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,5" HorizontalAlignment="Stretch">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="126" Height="175" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top">
                          <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                          <TextBlock Text="{Binding SeoTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding SeoDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="52" Margin="0,5,0,0"/>
                          <TextBlock Text="{Binding SeoHashtags}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                          <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Instant Publish" IsChecked="{Binding IsInstant, Mode=TwoWay}" Margin="0,0,22,0"/>
                            <CheckBox Content="Schedule" IsChecked="{Binding IsScheduled, Mode=TwoWay}"/>
                          </StackPanel>
                          <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsScheduled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Schedule date &amp; time (local: YYYY-MM-DD HH:MM)" Foreground="{StaticResource Muted}"/>
                            <TextBox Width="250" HorizontalAlignment="Left" Text="{Binding ScheduleDateText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            <StackPanel Grid.Row="2" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource SecondaryButton}" Content="Generate SEO Metadata" Command="{Binding GeneratePublishMetadataCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Remove Selected" Command="{Binding RemovePublishQueueCommand}"/>
              </StackPanel>
              <Separator Margin="0,4,0,8"/>
              <TextBlock Text="Bulk Schedule Interval" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Applies to videos with Schedule checked. Choose the first local posting date/time and spacing between videos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <StackPanel Orientation="Horizontal">
                <TextBox Width="220" Text="{Binding PublishFirstSlot, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Width="110" Margin="10,0,0,0" ItemsSource="{Binding PublishIntervals}" SelectedItem="{Binding PublishIntervalHours}"/>
                <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
              <Button Style="{StaticResource SecondaryButton}" Content="Apply Bulk Schedule" Command="{Binding SchedulePublishQueueCommand}" HorizontalAlignment="Left" Margin="0,9,0,14"/>
              <Separator Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="160" ItemsSource="{Binding PublishDestinations}" SelectedItem="{Binding PublishDestination}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Publish Selected" Command="{Binding BrowserPublishCommand}" Margin="12,0,0,0"/>
              </StackPanel>
              <Expander Header="Temporary Publishing Checkpoint (optional)" Margin="0,8,0,0" IsExpanded="False">
              <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,4">
                <StackPanel>
                  <TextBlock Text="Temporary Publishing Checkpoint" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="If posting stops, record the last step you verified. Each video and platform has its own saved checkpoint. Remove this helper once publishing is reliable." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,9"/>
                  <ComboBox Width="270" HorizontalAlignment="Left" ItemsSource="{Binding PublishCheckpointStages}" SelectedItem="{Binding PublishCheckpointStage}"/>
                  <TextBox Width="600" HorizontalAlignment="Left" Text="{Binding PublishCheckpointNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Save Checkpoint" Command="{Binding SavePublishCheckpointCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Resume in Studio" Command="{Binding ResumePublishCheckpointCommand}"/>
                  </StackPanel>
                  <TextBlock Text="Resume reopens Studio; inspect existing drafts or uploads before retrying. ZeroVideo cannot restore partially submitted browser forms automatically." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              </Expander>
              <CheckBox Content="I have rights to this video and authorize opening the platform uploader." IsChecked="{Binding PublishConsent}" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding PublishStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <TextBlock Text="Playwright selects the video and prepares supported metadata. Review everything and confirm publication or scheduling manually in Studio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="Settings">
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Dependencies &amp; paths" FontSize="21" FontWeight="SemiBold"/>
            <Label Content="PROJECTS ROOT" Margin="0,12,0,0"/><TextBox Width="740" Text="{Binding Settings.ProjectsRoot}"/>
            <Label Content="FFMPEG.EXE" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.FfmpegPath}"/>
            <Label Content="FFPROBE.EXE" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.FfprobePath}"/>
            <Separator Margin="0,18"/>
            <TextBlock Text="Clipchamp TTS defaults" FontSize="18" FontWeight="SemiBold"/>
            <Label Content="LANGUAGE LABEL" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.ClipchampLanguage}"/>
            <Label Content="VOICE LABEL" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.ClipchampVoice}"/>
            <TextBlock Text="The Create tab voice overrides this default for the active project. Leave blank to keep Clipchamp's current/default voice." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Separator Margin="0,18"/>
            <TextBlock Text="Custom background music" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a licensed audio file. When Music is checked in Create or Shorts, it loops until the video ends." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <Label Content="MUSIC FILE"/>
            <TextBox Width="740" Text="{Binding Settings.BackgroundMusicPath, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseMusicCommand}" Content="Browse music file..." HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <Label Content="BACKGROUND MUSIC LEVEL (dB)" Margin="0,10,0,0"/>
            <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding MusicLevelsDb}" SelectedItem="{Binding Settings.BackgroundMusicDb, Mode=TwoWay}"/>
            <WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallFfmpegCommand}" Content="Install FFmpeg automatically"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" Content="Save settings"/></WrapPanel>
            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap">FFmpeg is installed in ZeroVideo's persistent tools folder so app updates do not remove it.</TextBlock>
          </StackPanel></ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#17171E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="11,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/></Grid>
    </Border>
  </Grid>
</Window>
