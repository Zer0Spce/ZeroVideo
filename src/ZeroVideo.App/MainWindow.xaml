                <CheckBox Content="Music" IsChecked="{Binding Project.Options.AddBackgroundMusic}"/>
                <CheckBox Content="SFX hooks" IsChecked="{Binding Project.Options.AddSoundEffects}"/>
                <Button Style="{StaticResource ClipchampSecondaryButton}" Command="{Binding ContinueTtsCommand}" Content="Continue TTS" IsEnabled="{Binding WaitingForTtsContinue}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Thumbnail" FontWeight="SemiBold"/>
                <TextBlock Text="Creates a title-specific widescreen 16:9 cover saved as thumbnail.png in each project folder." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Publishing" FontWeight="SemiBold"/>
                <TextBlock Text="Finished long-form MP4s appear in the same Publishing queue with automatic metadata. TikTok posting eligibility depends on your account and video duration. YouTube publishing is disabled." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Idea Generation">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="Idea Generation" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Generate compelling video titles and opening hooks for any niche. Ideas aim for curiosity and retention, not guaranteed views." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
              <Label Content="NICHE"/>
              <TextBox Text="{Binding IdeaNiche, UpdateSourceTrigger=PropertyChanged}" ToolTip="Examples: Horror, True Crime, History, Science, Space"/>
              <Label Content="NUMBER OF IDEAS" Margin="0,10,0,0"/>
              <TextBox Text="{Binding IdeaCount, UpdateSourceTrigger=LostFocus}"/>
              <Button Style="{StaticResource PrimaryButton}" Content="Generate video ideas" Command="{Binding GenerateIdeasCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
              <Button Style="{StaticResource SecondaryButton}" Content="Smart Ideas — Trending Now" Command="{Binding GenerateSmartIdeasCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                      ToolTip="Use dated Google News/Trends headlines and ChatGPT to suggest niche-relevant original video ideas. Requires internet."/>
              <TextBlock Text="{Binding IdeaStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
              <Separator Margin="0,14"/>
              <TextBlock Text="Check several ideas and choose either Short Form or Long Form Automation. Each queue is independent and duplicate titles are skipped." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Check All" Command="{Binding CheckAllIdeasCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Clear Checks" Command="{Binding ClearIdeaChecksCommand}"/>
              </StackPanel>
              <WrapPanel Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="+ Add To Short Form"
                        Command="{Binding QueueSelectedIdeaCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="+ Add To Long Form"
                        Command="{Binding QueueSelectedIdeasToLongFormCommand}"/>
              </WrapPanel>
              <Button Style="{StaticResource SecondaryButton}" Content="Use highlighted idea in Create" Command="{Binding UseSelectedIdeaCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Generated ideas — title and hook" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <DataGrid ItemsSource="{Binding GeneratedIdeas}" SelectedItem="{Binding SelectedIdea, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Use" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Select this idea, then add to Short Form or Long Form"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Video title" Binding="{Binding Title}" IsReadOnly="True" Width="2*"/>
                  <DataGridTextColumn Header="Opening hook" Binding="{Binding Hook}" IsReadOnly="True" Width="3*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Content Series">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="Content Series Generator" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Plan a connected series of unique, standalone episodes. Generated titles and hooks can be queued independently for short-form or long-form production."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
              <Label Content="SERIES THEME / NICHE"/>
              <TextBox Text="{Binding SeriesTheme, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>
              <Label Content="NUMBER OF EPISODES (3–30)" Margin="0,12,0,0"/>
              <TextBox Text="{Binding SeriesEpisodeCount, UpdateSourceTrigger=LostFocus}"/>
              <Button Style="{StaticResource PrimaryButton}" Content="Generate Content Series"
                      Command="{Binding GenerateContentSeriesCommand}" HorizontalAlignment="Left"
                      Margin="0,14,0,6"/>
              <TextBlock Text="{Binding SeriesStatus}" Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap" Margin="0,7,0,12"/>
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="+ Add To Short Form"
                        Command="{Binding AddContentSeriesToShortsCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="+ Add To Long Form"
                        Command="{Binding AddContentSeriesToLongFormCommand}"/>
              </WrapPanel>
              <TextBlock Text="The episode plan is generated using ChatGPT. It does not start video creation or publishing until you start the selected automation queue."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Series episode plan"
                         FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <DataGrid ItemsSource="{Binding SeriesEpisodes}" AutoGenerateColumns="False"
                        CanUserAddRows="False" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Use" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Episode" Width="2*" Binding="{Binding Title}" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Story hook" Width="3*" Binding="{Binding Hook}" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Effects">
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="Visual Effects Engine" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Keep still images alive for their entire on-screen duration and automatically vary motion so long videos do not feel repetitive." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/>

              <CheckBox Content="Visual Motion" IsChecked="{Binding Project.Options.AddMotion}"/>
              <CheckBox Content="Continuous Scene Motion" IsChecked="{Binding Project.Options.ContinuousMotion}" ToolTip="Loop smooth motion for the entire time a still image remains on screen."/>
              <Grid Margin="18,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <TextBlock Text="Motion changes every" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="65" Text="{Binding Project.Options.MotionCycleSeconds, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/><TextBlock Text=" sec" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
              </Grid>
              <Label Content="MOTION STYLE" Margin="0,10,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.MotionStyle, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Cinematic"/><ComboBoxItem Content="Documentary"/><ComboBoxItem Content="Dynamic"/><ComboBoxItem Content="Minimal"/><ComboBoxItem Content="None"/>
              </ComboBox>

              <Separator Margin="0,14"/>
              <CheckBox Content="Scene Transitions" IsChecked="{Binding Project.Options.SceneTransitions}"/>
              <Label Content="TRANSITION STYLE" Margin="0,8,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.TransitionStyle, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Crossfade"/><ComboBoxItem Content="Fade Black"/><ComboBoxItem Content="Fade White"/><ComboBoxItem Content="Slide"/><ComboBoxItem Content="Push"/><ComboBoxItem Content="Zoom"/><ComboBoxItem Content="Blur"/><ComboBoxItem Content="Paper Swipe"/><ComboBoxItem Content="Marker Wipe"/><ComboBoxItem Content="None"/>
              </ComboBox>
            </StackPanel></ScrollViewer>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="Cinematic treatment" FontSize="21" FontWeight="SemiBold"/>
              <CheckBox Content="Cinematic Effects" IsChecked="{Binding Project.Options.CinematicEffects}" Margin="0,10,0,0"/>
              <CheckBox Content="Style-aware Effects" IsChecked="{Binding Project.Options.StyleAwareEffects}" ToolTip="Documentary, mystery, history, VOX, cartoon, stickman and whiteboard styles receive different treatments."/>
              <Label Content="EFFECT INTENSITY" Margin="0,8,0,0"/>
              <ComboBox SelectedValue="{Binding Project.Options.EffectIntensity, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Subtle"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Strong"/>
              </ComboBox>

              <Separator Margin="0,14"/>
              <CheckBox Content="Smart Parallax (Beta)" IsChecked="{Binding Project.Options.SmartParallax}"/>
              <TextBlock Text="Creates a soft foreground layer plus an enlarged background layer, then moves them at different speeds with a slow camera push. Best on images with a clear central subject." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="18,2,0,10"/>

              <CheckBox Content="Avoid Repeating Effects" IsChecked="{Binding Project.Options.AvoidRepeatedEffects}"/>
              <TextBlock Text="ZeroVideo remembers recent motion and transition choices across chapters, avoiding sequences such as zoom → zoom → zoom. Automatic mode rotates push, pan, drift, static, pull-back and parallax." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="18,2,0,0"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Automation">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Browser sessions" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Open ChatGPT to sign in. Clipchamp remains available only when selected as your narration engine." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenChatGptCommand}" Content="Open ChatGPT"/><Button Style="{StaticResource ClipchampPrimaryButton}" Command="{Binding OpenClipchampCommand}" Content="Open Clipchamp"/></WrapPanel><Button Style="{StaticResource SecondaryButton}" Command="{Binding RunPreflightCommand}" Content="Run system checks" HorizontalAlignment="Left" Margin="0,14,0,6"/><ListBox ItemsSource="{Binding PreflightLines}" Height="190" FontFamily="Consolas" FontSize="12"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Automation profile" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Selectors are stored outside the code so ChatGPT/Clipchamp UI changes can be repaired without rebuilding the entire app." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/><Label Content="PROFILE PATH"/><TextBox Text="{Binding Settings.AutomationProfilePath}"/><Label Content="EDGE PROFILE DIRECTORY" Margin="0,10,0,0"/><TextBox Text="{Binding Settings.EdgeUserDataDirectory}"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" Content="Save automation settings" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Local Images">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel MaxWidth="990" HorizontalAlignment="Left" Margin="0,0,12,20">
            <TextBlock Text="Local Image Generation — ComfyUI" FontSize="24"
                       FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock Text="Run existing styles with ComfyUI on your NVIDIA GPU. Install the optional illustrated DreamShaper XL model and use scene-focused local prompts. The original ChatGPT engine remains available and unchanged."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,13"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="1. Choose image generation engine" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ComboBox Width="250" ItemsSource="{Binding ImageGenerationEngines}"
                            SelectedItem="{Binding Settings.ImageGenerationEngine, Mode=TwoWay}"
                            ToolTip="Keep ChatGPT for the original mode; Hybrid falls back when local generation fails."/>
                  <Button Style="{StaticResource SecondaryButton}"
                          Command="{Binding SaveSettingsCommand}" Content="Save engine choice" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="ChatGPT: unchanged current behavior. Local ComfyUI: local GPU only. Hybrid: local first, then ChatGPT if an image fails. Engine applies to new scene images; existing generated images are reused."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="2. One-click setup — ComfyUI + SDXL" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Downloads official NVIDIA ComfyUI portable (bundled Python/CUDA) and the 6.94 GB SDXL base model. Extracts to your local ZeroVideo data folder. Windows tar or installed 7-Zip is used automatically. Requires internet, available disk space and suitable NVIDIA drivers. Model SHA-256 is checked."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                <TextBlock Text="{Binding LocalImageAvailability}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button Style="{StaticResource PrimaryButton}" Content="Install Everything (1 Click)"
                          Command="{Binding InstallLocalImagesCommand}"
                          ToolTip="Confirm then download and extract ComfyUI and verified SDXL checkpoint. Partial downloads resume."/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Start Local Engine"
                          Command="{Binding StartLocalImagesCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Test Connection"
                          Command="{Binding TestLocalImagesCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding LocalImageStatus}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding LocalImageInstallFolder}" Foreground="{StaticResource Muted}"
                           FontSize="11" TextWrapping="Wrap"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Open Local AI Folder"
                        Command="{Binding OpenLocalImageFolderCommand}" HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>
                <TextBlock Text="No system Python installation, separate CUDA toolkit or API key is necessary for the portable package. Download size and setup time depend on your network and drive."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="3. Test your comic and cartoon styles" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Create the same detective scene in Cinematic Comic, Classic Comic Book and Editorial Cartoon styles. Samples use a repeatable seed for easier comparison across SDXL and DreamShaper XL."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,11"/>
                <WrapPanel>
                  <Button Style="{StaticResource PrimaryButton}" Content="Generate 3 Style Samples"
                          Command="{Binding BenchmarkLocalStylesCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="View Samples Folder"
                          Command="{Binding OpenLocalBenchmarkFolderCommand}"/>
                </WrapPanel>
                <CheckBox Content="Comic Book Explainer: generate 3 separate vintage panels and assemble the page"
                          IsChecked="{Binding Project.Options.VintageComicPanelComposition, Mode=TwoWay}"
                          Margin="0,10,0,0" ToolTip="Local ComfyUI only. Generates three separate illustrated story beats with thick black gutters. Uses about three times as many model renders per scene."/>
                <TextBlock Text="Vintage printed comics now use a dedicated three-panel compositor instead of asking one model to invent the entire page. Each local scene requires three renders, with character anchors reused. Other styles are unchanged."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="4. Illustrated Model and Checkpoint Selection" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="DreamShaper XL is an optional illustration-focused alternative to the default SDXL model. Its 6.94 GB download is verified against the creator's published SHA-256. Review the model license before commercial use. Neither model is deleted when switching."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Style="{StaticResource PrimaryButton}" Content="Install Better Illustrated Model (1 Click)"
                          Command="{Binding InstallIllustratedModelCommand}"
                          ToolTip="Download verified DreamShaper XL from its creator and choose it for future local image generation."/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Switch Back to SDXL Base"
                          Command="{Binding UseBaseModelCommand}"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Install FLUX.1-schnell Q4 (8GB GPU)"
                          Command="{Binding InstallFluxSchnellCommand}"
                          ToolTip="Optional install of FLUX Q4 + text encoders + VAE and ComfyUI-GGUF; ~12 GB download, high RAM use."/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Repair FLUX GGUF Nodes"
                          Command="{Binding RepairFluxNodesCommand}"
                          ToolTip="Check extension files, Python gguf dependency and live UnetLoaderGGUF node; repair missing dependency and restart only ZeroVideo-owned ComfyUI."/>
                </WrapPanel>
                <TextBlock Text="SELECT A LOCAL MODEL" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,5"/>
                <ComboBox Width="440" HorizontalAlignment="Left"
                          ItemsSource="{Binding LocalImageModelChoices}"
                          SelectedItem="{Binding Settings.LocalImageCheckpointFile, Mode=TwoWay}"
                          ToolTip="Only installed checkpoints can generate images."/>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveSettingsCommand}" Content="Save Model Choice"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <TextBlock Text="Model license: https://huggingface.co/Lykon/DreamShaper"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Restart Local Engine (load new nodes)"
                        Command="{Binding RestartLocalEngineCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                <TextBlock Text="FLUX schnell Q4 uses about 12 GB of extra model assets and may need RAM offloading on your RTX 3060 8GB. It is an optional trial, not a guaranteed improvement for every comic style."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Troubleshooting: if ComfyUI reports missing_node_type UnetLoaderGGUF, choose Repair FLUX GGUF Nodes. The app checks the live node registry before rendering. If a different process started ComfyUI on 127.0.0.1:8188, close that server yourself and click Start Local Engine; ZeroVideo will never terminate a server it did not launch."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Local ComfyUI listens only on 127.0.0.1:8188. It does not require a TikTok login, cannot publish a video and does not modify caption, audio or browser automation."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="5. Character Bible — Consistent recurring cast" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="OFF by default for varied documentary scenes. Enable only when the SAME PERSON appears visibly across multiple shots. ZeroVideo keeps a person's identity description, but changes the scene seed, background, camera angle and composition. Import an isolated character portrait if needed; it will NEVER reuse an automatically generated trailer, house or landscape as a portrait. ChatGPT image generation is unchanged."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                <CheckBox Content="Enable Character Bible (visible people only — OFF recommended for scenery)"
                          IsChecked="{Binding Project.Options.EnableCharacterConsistency, Mode=TwoWay}"
                          ToolTip="OFF: independent scene compositions. ON: only visible named people receive identity guidance; an approved imported portrait is optional. Click Save Character Bible after changing."
                          Margin="0,0,0,9"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Style="{StaticResource SecondaryButton}" Content="Detect Recurring Characters from Script"
                          Command="{Binding DetectCharactersCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Save Character Bible"
                          Command="{Binding SaveCharactersCommand}"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Project.Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" Height="165" MinWidth="600">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Lock" Binding="{Binding Enabled, Mode=TwoWay}" Width="55"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                    <DataGridTextColumn Header="Character appearance / outfit"
                                        Binding="{Binding Appearance, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    <DataGridTextColumn Header="Master reference image"
                                        Binding="{Binding ReferenceImagePath}" IsReadOnly="True" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Label Content="NEW CHARACTER NAME" Margin="0,10,0,0"/>
                <TextBox Width="300" HorizontalAlignment="Left"
                         Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="APPEARANCE / OUTFIT DETAILS" Margin="0,7,0,0"/>
                <TextBox Text="{Binding NewCharacterAppearance, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Add Character"
                          Command="{Binding AddCharacterCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Import Approved Reference Image"
                          Command="{Binding ImportCharacterImageCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Remove Selected Character Profile"
                          Command="{Binding DeleteCharacterCommand}"
                          ToolTip="Remove only the cast entry, never any PNG or existing project image."/>
                </WrapPanel>
                <TextBlock Text="{Binding CharacterStatus}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                <TextBlock Text="Tip: for environments, buildings, vehicles, nature and evidence shots, leave Character Bible OFF. For recurring human subjects, enable it and import a tightly cropped face/character reference. Old auto-generated full-scene references are now ignored. Changing this setting affects newly generated images, not PNGs already saved; regenerate a scene to see a different composition."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Identity Studio">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel MaxWidth="990" HorizontalAlignment="Left" Margin="0,0,12,20">
            <TextBlock Text="Identity Studio" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock Text="Visible here: Real Person Identity Lock, auto ChatGPT portrait creation, manual photo references, and one-click PuLID-FLUX setup. Settings apply to the active project only. Choose a real person's full name to begin."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Real Person Identity Lock (FLUX — optional)" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Maintain the recognizable face of a real person (Zak Bagans, Jeffrey Dahmer, etc.) from 1–3 approved local portrait photos. Only scenes visibly depicting that named person use identity conditioning. This is separate from Character Bible: background, clothing, framing and scene actions are free to change. OFF by default; no automatic photo scraping."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,9"/>
                <Border Background="{StaticResource AccentSoft}" Padding="12" CornerRadius="10" Margin="0,4,0,12">
                  <StackPanel>
                    <TextBlock Text="AUTO REAL-PERSON IDENTITY — HANDS-FREE" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Automatically detect the video's main person, generate and attach temporary ChatGPT portraits"
                              IsChecked="{Binding Project.Options.AutoRealPersonIdentity, Mode=TwoWay}"
                              ToolTip="Default ON. Runs only for a clear named person in the title/topic and the supported local FLUX + PuLID image workflow. Unsupported topics use normal images."
                              Margin="0,0,0,7"/>
                    <WrapPanel Margin="0,1,0,9">
                      <TextBlock Text="Temporary portrait guides per video:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ComboBox Width="70" HorizontalAlignment="Left"
                                ItemsSource="{Binding IdentityPortraitCountOptions}"
                                SelectedItem="{Binding Project.Options.AutoIdentityPortraitCount, Mode=TwoWay}"/>
                    </WrapPanel>
                    <TextBlock Text="During Create / Shorts / Long Form automation: detects the named subject (e.g. Zak Bagans or Jeffrey Dahmer), generates 1–2 matching-style ChatGPT portrait guides, attaches them only for this video, and reuses them if a job resumes. AFTER the finished MP4, only those automatically generated files are deleted and detached. Manual photos, completed images, voice assets and backups are never deleted. If PuLID is not installed, normal image generation continues."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock Text="For best likeness, import a genuine approved photo; synthetic ChatGPT celebrity portraits are approximate and cannot authenticate the person's face. Auto mode operates on Local ComfyUI / Hybrid FLUX with the PuLID adapter, not ChatGPT-only scene generation."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <CheckBox Content="Enable Real Person Identity Lock for this project"
                          IsChecked="{Binding Project.Options.EnableRealPersonIdentityLock, Mode=TwoWay}"
                          ToolTip="Only applies to explicitly named, visible people with approved reference photos using local FLUX and a PuLID identity adapter."
                          Margin="0,2,0,8"/>
                <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="10" Margin="0,7,0,14">
                  <StackPanel>
                    <TextBlock Text="QUICK START — AUTO REFERENCES" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Select a person below, or enter their name (e.g. Zak Bagans). ZeroVideo can send 1–2 portrait prompts to your signed-in ChatGPT, capture each original PNG, and attach the finished illustrations to this project automatically. Uses the current project visual style."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel>
                      <Button Style="{StaticResource PrimaryButton}"
                              Content="Auto Generate &amp; Attach ChatGPT Portraits"
                              Command="{Binding GenerateChatGptIdentityGuidesCommand}"
                              ToolTip="Generates 1–2 single-face stylized portraits in ChatGPT and saves real PNGs under your project identity references folder."/>
                      <TextBlock Text="Portraits" VerticalAlignment="Center" Margin="12,0,4,0"/>
                      <ComboBox Width="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                                ItemsSource="{Binding IdentityPortraitCountOptions}"
                                SelectedItem="{Binding IdentityPortraitCount, Mode=TwoWay}"/>
                    </WrapPanel>
                    <TextBlock Text="AI-generated references approximate public figures; they are NOT verified historical photos or guaranteed likenesses. For accuracy use Import Approved Face Photo. ZeroVideo never silently scrapes pictures from websites."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="REAL PERSON REFERENCE PROFILES" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <DataGrid ItemsSource="{Binding Project.RealPeople}"
                          SelectedItem="{Binding SelectedRealPerson, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" Height="147" MinWidth="600">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use" Binding="{Binding Enabled, Mode=TwoWay}" Width="55"/>
                    <DataGridTextColumn Header="Real person name" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Attached refs (up to 3)"
                                        Binding="{Binding ReferencePaths.Count}" IsReadOnly="True" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Label Content="FULL NAME (MATCHED AGAINST VISIBLE SCENES)" Margin="0,8,0,0"/>
                <TextBox Width="360" HorizontalAlignment="Left"
                         Text="{Binding NewRealPersonName, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel Margin="0,9,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Add Named Person"
                          Command="{Binding AddRealPersonCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Import Approved Face Photo"
                          Command="{Binding ImportRealPersonPhotoCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Clear Selected Photos"
                          Command="{Binding ClearRealPersonPhotosCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Remove Person"
                          Command="{Binding RemoveRealPersonCommand}"/>
                </WrapPanel>
                <Label Content="IDENTITY CONDITIONING STRENGTH (0.35–1.10)" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider Width="260" Minimum="0.35" Maximum="1.10"
                          TickFrequency="0.05" IsSnapToTickEnabled="True"
                          Value="{Binding Project.Options.RealPersonIdentityStrength, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Project.Options.RealPersonIdentityStrength, StringFormat=F2}"
                             Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Save Identity Lock"
                          Command="{Binding SaveIdentityLockCommand}"/>
                  <Button Style="{StaticResource PrimaryButton}"
                          Content="Install &amp; Set Up PuLID-FLUX (1 Click)"
                          Command="{Binding InstallPuLidNodesCommand}"
                          ToolTip="Installs the pinned PuLID extension and compatible FaceNet dependencies into ZeroVideo's existing local ComfyUI, then downloads verified model weights."/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Download PuLID Identity Models (~2GB)"
                          Command="{Binding DownloadPuLidIdentityModelsCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Test PuLID Identity Adapter"
                          Command="{Binding TestIdentityAdapterCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding IdentityLockStatus}" Foreground="{StaticResource AccentHover}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Click Install &amp; Set Up PuLID-FLUX to install the required extension, FaceNet and official model weights automatically into ZeroVideo's existing ComfyUI. Then restart/test the nodes as prompted. Works only with Local FLUX; ChatGPT scene generation is unchanged. Setup requires your consent and network access."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="GPU note: PuLID workflows primarily target FLUX.1-dev and typically require more VRAM than the current 8GB RTX 3060. The installed FLUX.1-schnell Q4 pathway is experimental; do not expect guaranteed likeness or successful inference. Stop other heavy GPU processes before testing. Use photos you have permission to use and clearly label reconstructed imagery when appropriate."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Voice Studio">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel an ongoing OmniVoice installation or narration test without deleting saved profiles."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Terminate ZeroVideo-owned OmniVoice synthesis or setup processes if they are stuck."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="580"/>
          </StackPanel>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="335"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="My Voice Library" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="Saved clones stay on this PC, separate from your video projects."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <TextBlock Text="SELECTED VOICE" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding SelectedOmniProfile.Name, FallbackValue='No voice selected', TargetNullValue='No voice selected'}"
                             FontSize="15" FontWeight="SemiBold" Margin="0,0,0,11"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Use Voice in Automation"
                          Command="{Binding UseOmniProfileCommand}"
                          ToolTip="Use this saved clone for future Shorts and Long Form chapter audio. Non-commercial model evaluation only."/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Test Saved Voice"
                            Command="{Binding TestOmniVoiceCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Remove from Library"
                            Command="{Binding RemoveOmniProfileCommand}"
                            ToolTip="Remove only its library entry, without deleting source recordings or generated WAVs."/>
                  </WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Content="Open Voice Files Folder"
                          Command="{Binding OpenOmniFolderCommand}" Margin="0,10,0,0"
                          HorizontalAlignment="Left"/>
                  <TextBlock Text="Original Clipchamp voices remain available; selecting a clone does not change any completed video."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding OmniVoiceProfiles}"
                         SelectedItem="{Binding SelectedOmniProfile, Mode=TwoWay}"
                         Margin="0,0,0,2" MinHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="3,8">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedUtc, StringFormat='Saved {0:MMM d, yyyy}'}"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,20">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="OmniVoice — Voice Clone Studio" FontSize="22"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Import a short voice recording, test its cloned narration, listen inside ZeroVideo, and save the approved voice to your library."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding OmniVoiceAvailability}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel>
                      <Button Style="{StaticResource PrimaryButton}"
                              Content="Install OmniVoice (1 Click)"
                              Command="{Binding InstallOmniVoiceCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="LICENSE: Official OmniVoice pretrained weights are CC BY-NC 4.0. Commercial or monetized video use requires separate authorization. This integrated engine is for non-commercial evaluation only."
                               Foreground="#FBC9A7" TextWrapping="Wrap" Margin="0,11,0,8"/>
                    <CheckBox Content="I understand: OmniVoice model weights are non-commercial evaluation only"
                              IsChecked="{Binding Settings.OmniVoiceNonCommercialAcknowledged, Mode=TwoWay}"
                              Margin="0,0,0,9"/>
                    <TextBlock Text="NARRATION ENGINE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="0,3,0,4"/>
                    <ComboBox ItemsSource="{Binding TextToSpeechEngines}"
                              SelectedItem="{Binding Settings.TextToSpeechEngine, Mode=TwoWay}"
                              Width="240" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Save TTS Settings"
                            Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"
                            Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="1. Create a Voice Clone" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="For best results, use 3–10 seconds of clear, single-speaker audio. Enter a transcript that matches the first 10 seconds of the sample."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                    <TextBlock Text="VOICE NAME" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding OmniProfileName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,9"/>
                    <TextBlock Text="REFERENCE AUDIO" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                      <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                              Content="Browse Audio..." Command="{Binding BrowseOmniReferenceCommand}"/>
                      <TextBox Text="{Binding OmniReferenceSource, UpdateSourceTrigger=PropertyChanged}"
                               IsReadOnly="True" Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock Text="WORDS SPOKEN IN REFERENCE AUDIO" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding OmniReferenceTranscript, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                    <CheckBox Content="I own this voice or have the speaker's permission to clone it"
                              IsChecked="{Binding OmniVoiceSampleAuthorized, Mode=TwoWay}"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="Reference audio and transcripts are saved locally under ZeroVideo/LocalTTS. They are not sent to Clipchamp or ChatGPT."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="2. Test the Voice" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Write a short narration sample. You can test your new, unsaved voice or any voice already in the library."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                    <TextBox Text="{Binding OmniTestText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"
                             MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="VOICE SPEED" FontSize="11" Foreground="{StaticResource Muted}"
                               Margin="0,12,0,4"/>
                    <Slider Minimum="0.7" Maximum="1.3" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Width="280"
                            HorizontalAlignment="Left"
                            Value="{Binding Settings.OmniVoiceSpeed, Mode=TwoWay}"/>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource PrimaryButton}" Content="Generate Clone Preview"
                              Command="{Binding PreviewNewOmniVoiceCommand}"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Test Saved Voice"
                              Command="{Binding TestOmniVoiceCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="The first voice test loads the model into GPU memory; local FLUX image generation should not run at the same time on an 8GB GPU."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="3. Listen &amp; Save Your Clone" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Preview the result before saving a new clone. Your named voice can then be reused for future Shorts and Long Form narration."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                    <WrapPanel>
                      <Button Style="{StaticResource PrimaryButton}" Content="Play Preview"
                              Command="{Binding PlayOmniPreviewCommand}"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Stop Playback"
                              Command="{Binding StopOmniPreviewCommand}"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Save Clone to Library"
                              Command="{Binding ImportOmniProfileCommand}"
                              ToolTip="Save the current approved audio reference after a successful voice test."/>
                    </WrapPanel>
                    <TextBlock Text="{Binding OmniPreviewPath}" Foreground="{StaticResource Muted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <TextBlock Text="Studio Status" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LocalTtsStatus}" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="TikTok Intelligence" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel Margin="0,0,12,12">
            <TextBlock Text="TikTok Intelligence" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Optional, read-only analytics and trend research. Your account is opened in the existing dedicated Edge profile, and data is saved locally on this Windows PC. No TikTok passwords, private APIs, uploads or publishing settings are changed."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="1. TikTok Studio — Your Analytics" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Sign in manually to your own TikTok Studio. Capture only the visible Analytics page, or import an exported per-video CSV for reliable historical posting-hour analysis."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Style="{StaticResource SecondaryButton}" Content="Open TikTok Studio Analytics" Command="{Binding OpenTikTokAnalyticsCommand}"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Capture Visible Analytics" Command="{Binding CaptureTikTokAnalyticsCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Import Analytics CSV" Command="{Binding ImportTikTokAnalyticsCsvCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding TikTokAnalyticsStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Your TikTok Posting Insights" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding TikTokInsightsSummary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="2. TikTok Creative Center — Platform Trends" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Open TikTok Creative Center, select your preferred country/category and Trending Hashtags, then capture hashtags visible in the browser. No hidden data or invented ranks are used."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <WrapPanel Margin="0,0,0,8">
                  <Button Style="{StaticResource SecondaryButton}" Content="Open Creative Center Trends" Command="{Binding OpenTikTokCreativeCenterCommand}"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Capture Visible Trends" Command="{Binding CaptureTikTokTrendsCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding TikTokTrendsStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="3. AI Features Using Your Insights" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Smart Ideas 2.0 combines your historical high-view topics, recent captured Creative Center hashtags and dated public news/search signals when available. Smart Scheduling 2.0 considers observed posting-hour engagement before estimating daily time slots."
                           TextWrapping="Wrap" Margin="0,8,0,8"/>
                <TextBlock Text="Go to Idea Generation → Smart Ideas — Trending Now, or Publishing → AI Smart Schedule. Existing 1×–10× per day, checkboxes, bulk schedule, captions and TikTok publishing are unchanged."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="Limitations: Capture reads the current visible page, not a verified TikTok analytics API. CSV timestamps use this PC's local time. Suggested posting times are correlations and planning estimates, not guarantees."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Calendar">
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Visual Publishing Calendar" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Local queue schedules only — changing a date here does not modify an already submitted TikTok post."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Previous Month"
                        Command="{Binding PreviousCalendarMonthCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Today"
                        Command="{Binding CurrentCalendarMonthCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Next Month"
                        Command="{Binding NextCalendarMonthCommand}"/>
                <TextBlock Text="{Binding CalendarMonthLabel}" FontSize="20" FontWeight="SemiBold"
                           Margin="18,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Separator Margin="0,0,0,8"/>
              <TextBlock Text="EDIT SELECTED CALENDAR VIDEO" Foreground="{StaticResource Muted}" FontSize="11"/>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                <TextBox Width="190" Text="{Binding CalendarEditTime, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Future local date and time in YYYY-MM-DD HH:MM"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Apply New Date / Time"
                        Command="{Binding ApplyCalendarTimeCommand}" Margin="10,0,0,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Refresh"
                        Command="{Binding RefreshCalendarCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding CalendarStatus}" TextWrapping="Wrap"
                         Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <UniformGrid Columns="7" Margin="0,0,0,6">
                  <TextBlock Text="SUN" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="MON" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="TUE" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="WED" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="THU" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="FRI" TextAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="SAT" TextAlignment="Center" FontWeight="SemiBold"/>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding CalendarDays}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                              CornerRadius="6" Margin="2" Padding="5" MinHeight="108"
                              Background="#201F29" AllowDrop="True" Drop="OnCalendarDayDrop">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="{Binding DayLabel}" FontWeight="SemiBold"
                                     HorizontalAlignment="Right" Margin="0,0,0,4"/>
                          <ListBox ItemsSource="{Binding Videos}" BorderThickness="0" Background="Transparent"
                                   PreviewMouseMove="OnCalendarEntryPreviewMouseMove"
                                   MaxHeight="90" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   SelectedItem="{Binding DataContext.SelectedCalendarVideo,
                                   RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel ToolTip="{Binding Title}">
                                  <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#54DDE9" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Title}" FontSize="10"
                                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Video Library">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Finished Video Library" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Search completed MP4s in your existing Projects Root."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <TextBox Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by file path or filename"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Refresh Library"
                        Command="{Binding RefreshLibraryCommand}" HorizontalAlignment="Left" Margin="0,8,0,6"/>
                <TextBlock Text="{Binding LibraryStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding VideoLibrary}" SelectedItem="{Binding SelectedLibraryVideo, Mode=TwoWay}"
                       Margin="0,12,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Image Source="{Binding ThumbnailPath}" Width="56" Height="80" Stretch="UniformToFill"/>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PublishingStatus}" Foreground="{StaticResource Muted}"
                                   FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Foreground="{StaticResource Muted}" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Content="Play Preview"
                          Click="OnLibraryPlayClicked"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Pause"
                          Click="OnLibraryPauseClicked"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                          Click="OnLibraryStopClicked"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Open Full Video"
                          Command="{Binding OpenLibraryVideoCommand}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Open Project Folder"
                          Command="{Binding OpenLibraryFolderCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding SelectedLibraryVideo.VideoPath}" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                <TextBlock Text="Preview uses Windows media codecs. Open Full Video uses your default media player if the built-in preview cannot play this MP4."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
              <MediaElement x:Name="LibraryPreviewPlayer"
                            Source="{Binding SelectedLibraryVideo.VideoUri}"
                            LoadedBehavior="Manual" UnloadedBehavior="Stop"
                            Stretch="Uniform" MediaFailed="OnLibraryMediaFailed"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="File Manager">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" HorizontalAlignment="Left">
              <TextBlock Text="Smart File Management" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Organize safely with COPY-ONLY project ZIP archives. Existing MP4s, thumbnails, scripts, working folders and publishing queue entries stay in place."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18"/>
              <TextBlock Text="CHOOSE PROJECT" FontSize="12" Foreground="{StaticResource Muted}"/>
              <ComboBox Width="600" HorizontalAlignment="Left"
                        ItemsSource="{Binding VideoLibrary}" SelectedItem="{Binding SelectedLibraryVideo, Mode=TwoWay}"
                        DisplayMemberPath="Title" Margin="0,7,0,10"/>
              <WrapPanel>
                <Button Style="{StaticResource SecondaryButton}" Content="Refresh Projects"
                        Command="{Binding RefreshLibraryCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Preview Files / Archive Size"
                        Command="{Binding PreviewArchiveCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Create Verified Project ZIP"
                        Command="{Binding ArchiveLibraryProjectCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding FileManagementStatus}" TextWrapping="Wrap"
                         Margin="0,12,0,0"/>
              <Separator Margin="0,20,0,12"/>
              <TextBlock Text="Archive safety rules" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Archives are stored in the _ZeroVideoArchives folder inside Projects Root. The operation copies the selected project's files into a ZIP and verifies the archive entry count before completion. No automatic file deletion, renaming, moving or publishing is performed."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Publishing">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <Grid Margin="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                <CheckBox Content="Select All" IsChecked="{Binding AllPublishItemsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                          ToolTip="Check or uncheck all finished videos for publishing and smart scheduling."
                          Margin="0,0,14,0"/>
                <TextBlock Text="Finished Video Queue" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Check the videos you want to publish to TikTok. Checked videos will upload one by one in the order shown. YouTube metadata is saved for later use."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MinHeight="110" Margin="0,0,0,8">
              <ItemsControl ItemsSource="{Binding PublishingQueue}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                            HorizontalAlignment="Stretch" CornerRadius="10"
                            Background="#201F29" Padding="12" Margin="0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="37"/>
                          <ColumnDefinition Width="82"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="218"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  ToolTip="Include this video in TikTok batch publishing, bulk scheduling and metadata retry."/>
                        <Border Grid.Column="1" Width="78" Height="106" CornerRadius="7" ClipToBounds="True"
                                Background="#111117" VerticalAlignment="Center">
                          <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="14,2,16,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SeoTitle}" FontSize="15" FontWeight="SemiBold"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource Text}" ToolTip="{Binding SeoTitle}"/>
                          <TextBlock Text="{Binding SeoDescription}" Foreground="{StaticResource Muted}"
                                     FontSize="11.5" TextWrapping="Wrap" MaxHeight="34"
                                     Margin="0,6,0,7" ToolTip="{Binding SeoDescription}"/>
                          <WrapPanel>
                            <Border Background="#233038" CornerRadius="5" Padding="7,3" Margin="0,0,7,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TIKTOK " Foreground="#54DDE9" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding TikTokStatus}" Foreground="{StaticResource Text}" FontSize="10"/>
                              </StackPanel>
                            </Border>
                            <Border Background="#30283D" CornerRadius="5" Padding="7,3">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="METADATA " Foreground="#C4B5FD" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding MetadataStatus}" Foreground="{StaticResource Text}" FontSize="10"/>
                              </StackPanel>
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                        <Border Grid.Column="3" BorderBrush="{StaticResource Border}"
                                BorderThickness="1,0,0,0" Padding="14,0,0,0" Margin="0,2,0,2">
                          <StackPanel VerticalAlignment="Center">
                            <CheckBox Content="Schedule on TikTok" IsChecked="{Binding IsScheduled, Mode=TwoWay}"
                                      FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel>
                              <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </StackPanel.Style>
                              <TextBlock Text="LOCAL DATE · TIME" FontSize="10" Foreground="{StaticResource Muted}"/>
                              <TextBox Width="182" HorizontalAlignment="Left"
                                       Text="{Binding ScheduleDateText, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip="YYYY-MM-DD HH:MM. TikTok uses 5-minute increments."
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Post immediately" FontSize="11" Foreground="{StaticResource Muted}"
                                       Margin="0,5,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource SecondaryButton}" Content="Check All" Command="{Binding SelectAllPublishQueueCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Clear Checks" Command="{Binding ClearPublishQueueSelectionCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Retry Metadata" Command="{Binding GeneratePublishMetadataCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Remove Checked" Command="{Binding RemovePublishQueueCommand}"/>
              </StackPanel>
              <Separator Margin="0,4,0,8"/>
              <TextBlock Text="Bulk TikTok Schedule" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Applies to CHECKED videos in queue order. Set the first local date/time; all checked videos will be set to Schedule automatically with the selected interval. Use 5-minute time increments."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <StackPanel Orientation="Horizontal">
                <TextBox Width="220" Text="{Binding PublishFirstSlot, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="YYYY-MM-DD HH:MM"/>
                <ComboBox Width="110" Margin="10,0,0,0" ItemsSource="{Binding PublishIntervals}"
                          SelectedItem="{Binding PublishIntervalHours}"/>
                <TextBlock Text="hours apart" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,9,0,4">
                <Button Style="{StaticResource SecondaryButton}" Content="Apply Bulk Schedule"
                        Command="{Binding SchedulePublishQueueCommand}"/>
                <TextBlock Text="AI posts per day:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="18,0,6,0"/>
                <ComboBox Width="76" ItemsSource="{Binding SmartPostsPerDayOptions}"
                          SelectedItem="{Binding SmartPostsPerDay, Mode=TwoWay}"
                          ToolTip="Select 1x to 10x posts per calendar day."/>
                <TextBlock Text="× / day" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="6,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="AI Smart Schedule"
                        Command="{Binding SmartSchedulePublishQueueCommand}"
                        ToolTip="ChatGPT recommends daily posting hours, then ZeroVideo spreads all checked videos across consecutive days at this daily frequency. Review before applying; this does not publish."/>
              </StackPanel>
              <TextBlock Text="Smart Schedule: select 1–10 posts per day. Checked videos are distributed in order, beginning tomorrow, within a conservative 20-day window. Use Select All to include the whole available queue."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"/>
              <Separator Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="TikTok Only" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="#54DDE9"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Publish Checked to TikTok"
                        Command="{Binding BrowserPublishCommand}" Margin="12,0,0,0"/>
              </StackPanel>
              <CheckBox Content="I have rights to the checked videos and authorize TikTok scheduling/posting, including the automatic Continue to post confirmation."
                        IsChecked="{Binding PublishConsent}" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding PublishStatus}" Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap" Margin="0,10,0,0"/>
              <TextBlock Text="Videos are submitted sequentially. ZeroVideo never retries an uncertain TikTok submission automatically. YouTube uploads are disabled, but YouTube SEO metadata remains available."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Dependencies &amp; paths" FontSize="21" FontWeight="SemiBold"/>
            <Label Content="PROJECTS ROOT" Margin="0,12,0,0"/><TextBox Width="740" Text="{Binding Settings.ProjectsRoot}"/>
            <Label Content="FFMPEG.EXE" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.FfmpegPath}"/>
            <Label Content="FFPROBE.EXE" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.FfprobePath}"/>
            <Separator Margin="0,18"/>
            <StackPanel Style="{StaticResource ClipchampVoicePanel}">
              <TextBlock Text="Clipchamp TTS defaults" FontSize="18" FontWeight="SemiBold"/>
              <Label Content="LANGUAGE LABEL" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.ClipchampLanguage}"/>
              <Label Content="VOICE LABEL" Margin="0,10,0,0"/><TextBox Width="740" Text="{Binding Settings.ClipchampVoice}"/>
              <TextBlock Text="The Create tab voice overrides this default for the active project. Leave blank to keep Clipchamp's current/default voice." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Style="{StaticResource LocalNarratorPanel}">
              <TextBlock Text="Current saved narrator" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ActiveNarrationVoiceName}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="{StaticResource AccentHover}"/>
              <TextBlock Text="Voice Studio manages your saved narrator. Clipchamp settings are hidden while this engine is active."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Separator Margin="0,18"/>
            <TextBlock Text="Local AI Image Animation — LivePortrait" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="LivePortrait is for small movements on visible human faces: one blink, slight head movement, subtle expressions. It uses ZeroVideo's existing ComfyUI installation, not Wan or FramePack. Scenes without a recognizable face automatically fall back to camera motion. This does not animate coats, grass, smoke or buildings."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,8"/>
            <WrapPanel Margin="0,3,0,8">
              <Button Content="1. Install LivePortrait" Style="{StaticResource PrimaryButton}"
                      Command="{Binding InstallLivePortraitCommand}"
                      ToolTip="Install official Kijai LivePortrait nodes and ZeroVideo's idle-blink driver into existing ComfyUI. May update its Python dependencies."/>
              <Button Content="2. Start / Restart ComfyUI" Style="{StaticResource SecondaryButton}"
                      Command="{Binding StartLivePortraitComfyUiCommand}"/>
              <Button Content="3. Test LivePortrait Connection" Style="{StaticResource SecondaryButton}"
                      Command="{Binding TestLivePortraitCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding LivePortraitStatus}" Foreground="{StaticResource AccentHover}"
                       TextWrapping="Wrap" Margin="0,3,0,8"/>
            <Label Content="ANIMATION ENGINE"/>
            <ComboBox Width="320" HorizontalAlignment="Left"
                      ItemsSource="{Binding AiImageAnimationEngines}"
                      SelectedItem="{Binding Settings.AiImageAnimationEngine, Mode=TwoWay}"/>
            <Label Content="LIVEPORTRAIT CLIP LENGTH (3–5 SECONDS)" Margin="0,8,0,0"/>
            <TextBox Width="120" Text="{Binding Settings.LivePortraitClipSeconds, UpdateSourceTrigger=LostFocus}"/>
            <Label Content="MAX FACIAL ANIMATION CLIPS PER VIDEO (0–30)" Margin="0,8,0,0"/>
            <TextBox Width="120" Text="{Binding Settings.LivePortraitMaxClipsPerVideo, UpdateSourceTrigger=LostFocus}"/>
            <Label Content="MOTION STRENGTH" Margin="0,8,0,0"/>
            <ComboBox Width="160" HorizontalAlignment="Left"
                      ItemsSource="{Binding LivePortraitMotionStrengthOptions}"
                      SelectedItem="{Binding Settings.LivePortraitMotionStrength, Mode=TwoWay}"/>
            <CheckBox Content="Natural blink (when a face is detected)"
                      IsChecked="{Binding Settings.LivePortraitBlink}" Margin="0,10,0,0"/>
            <CheckBox Content="Fallback to camera motion for unrecognized faces / environments"
                      IsChecked="{Binding Settings.LivePortraitFallbackToCamera}" Margin="0,5,0,0"/>
            <TextBlock Text="The first LivePortrait scene downloads its smaller face-animation model weights locally. Initial model/face-detection setup may take longer. Start with a single portrait scene, Low strength and a 3-second clip. FFmpeg camera motion remains available with no AI download."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/>
            <Separator Margin="0,18"/>
            <TextBlock Text="Clean up old Wan2.2 / FramePack models" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Optional: select Review &amp; Delete below to see exact file names, sizes, and paths before any removal. Only ZeroVideo-managed FramePack folders and named Wan model files can be recycled. The FLUX / SDXL models, your original media, OmniVoice, and external Hugging Face caches are never touched."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,7"/>
            <CheckBox Content="Also include shared Wan UMT5 text encoder (other workflows may require it)"
                      IsChecked="{Binding IncludeSharedWanTextEncoder}" Margin="0,3,0,8"/>
            <Button Content="Review &amp; Delete Old Wan2.2 / FramePack Models"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Command="{Binding ReviewDeleteLegacyAnimationCommand}"
                    ToolTip="Only after showing every exact path and receiving Yes confirmation. Sends files to Recycle Bin; no automatic deletion."/>
            <Separator Margin="0,18"/>
            <TextBlock Text="Custom background music" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a licensed audio file. When Music is checked in Create or Shorts, it loops until the video ends." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <Label Content="MUSIC FILE"/>
            <TextBox Width="740" Text="{Binding Settings.BackgroundMusicPath, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseMusicCommand}" Content="Browse music file..." HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <Label Content="BACKGROUND MUSIC LEVEL (dB)" Margin="0,10,0,0"/>
            <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding MusicLevelsDb}" SelectedItem="{Binding Settings.BackgroundMusicDb, Mode=TwoWay}"/>
            <WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallFfmpegCommand}" Content="Install FFmpeg automatically"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" Content="Save settings"/></WrapPanel>
            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap">FFmpeg is installed in ZeroVideo's persistent tools folder so app updates do not remove it.</TextBlock>
          </StackPanel></ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#17171E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="11,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/></Grid>
    </Border>
  </Grid>
</Window>
