<Window x:Class="ZeroVideo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZeroVideo" Width="1320" Height="900" MinWidth="1100" MinHeight="820" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
  <Window.Resources>
    <Style x:Key="ClipchampVoicePanel" TargetType="{x:Type StackPanel}">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomVoiceActive}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LocalNarratorPanel" TargetType="{x:Type StackPanel}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomVoiceActive}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ClipchampSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomVoiceActive}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ClipchampPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomVoiceActive}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootShell" Margin="22" Background="{StaticResource Bg}" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform Y="14"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16" Background="{StaticResource Bg}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="ZERO" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentHover}"/>
          <TextBlock Text="VIDEO" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Text}"/>
          <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,3" Margin="10,5,0,5"><TextBlock Text="WINDOWS" Foreground="#C4B5FD" FontSize="10" FontWeight="SemiBold"/></Border>
        </StackPanel>
        <TextBlock Text="Long-form AI video production studio" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadProjectCommand}" Content="Load project"/>
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenProjectFolderCommand}" Content="Open folder"/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="Create">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="New long-form video" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Label Content="TOPIC"/><TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True"/>

              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="LENGTH (MIN)"/><ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding Duration, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose the target video length."/></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="FORMAT"/><ComboBox ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding AspectRatio}"/></StackPanel>
              </Grid>

              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Label Content="STORY / EDIT STYLE"/>
                  <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose a visual/edit style."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <StackPanel Style="{StaticResource ClipchampVoicePanel}">
                    <Label Content="CLIPCHAMP VOICE"/>
                    <ComboBox ItemsSource="{Binding ClipchampVoices}" SelectedItem="{Binding Project.Voice, Mode=TwoWay}" IsEditable="False" ToolTip="Click to choose the Clipchamp TTS voice for this project."/>
                  </StackPanel>
                <StackPanel Style="{StaticResource LocalNarratorPanel}" Margin="0,8,0,0">
                  <Label Content="ACTIVE SAVED VOICE"/>
                  <TextBlock Text="{Binding ActiveNarrationVoiceName}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentHover}" TextWrapping="Wrap" Margin="5,2,0,0"/>
                  <TextBlock Text="Change the narrator in Voice Studio. Clipchamp is hidden while local narration is selected."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="5,5,0,0"/>
                </StackPanel>
                </StackPanel>
              </Grid>

              <Separator Margin="0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="New Chat" IsChecked="{Binding NewChat}" ToolTip="One-shot: start a fresh project chat on the next ChatGPT action."/>
              </Grid>

              <TextBlock Text="Output options" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,1"/>
              <CheckBox Content="Generate missing scene visuals" IsChecked="{Binding Project.Options.GenerateMissingVisuals}"/>
              <TextBlock Text="VISUAL IMAGE ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,3"/>
              <ComboBox Width="280" HorizontalAlignment="Left"
                        ItemsSource="{Binding ImageGenerationEngines}"
                        SelectedItem="{Binding Settings.ImageGenerationEngine, Mode=TwoWay}"
                        ToolTip="ChatGPT = original working image engine; Local ComfyUI = offline GPU; Hybrid = GPU then ChatGPT fallback."/>
              <TextBlock Text="Default: ChatGPT. Set up offline generation under Local Images."
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,5"/>

              <Border Background="#17151F" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="18,2,0,7">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="How Many Chapters" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.HowManyChapters, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Images Per Chapter" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.ImagesPerChapter, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Safety Total Image Cap" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Project.Options.MaxGeneratedVisuals, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>

              <WrapPanel Margin="0,0,0,2">
                <CheckBox Content=".SRT captions" IsChecked="{Binding Project.Options.GenerateCaptions}" Margin="0,4,15,4"/>
                <CheckBox Content="Bold in-video captions (9:16)" IsChecked="{Binding Project.Options.BurnInBoldCaptions}" Margin="0,4,15,4" ToolTip="Slightly smaller all-white uppercase subtitles with a black outline, centered near the lower third. Audio-pause-aware timing; adds a render pass."/>
                <CheckBox Content="Visual motion" IsChecked="{Binding Project.Options.AddMotion}" Margin="0,4,15,4"/>
              <CheckBox Content="Subtle image animation (4-second gentle loops)" IsChecked="{Binding Project.Options.SubtleImageAnimation}" Margin="0,4,15,4"
                        ToolTip="Smooth micro-pans, subtle breathing-like scale and gentle illumination. Lightweight FFmpeg processing, not generative AI facial animation."/>
              <StackPanel Margin="0,6,0,4">
                <TextBlock Text="IMAGE ANIMATION ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AiImageAnimationEngines}"
                          SelectedItem="{Binding Settings.AiImageAnimationEngine, Mode=TwoWay}"
                          ToolTip="Off, FFmpeg camera motion, or local LivePortrait for recognizable faces (automatic fallback)."/>
                <TextBlock Text="LivePortrait can animate visible faces with gentle blinks; install and test it under Settings."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10.5" Margin="0,5,0,0"/>
              </StackPanel>
                <CheckBox Content="Music" IsChecked="{Binding Project.Options.AddBackgroundMusic}" Margin="0,4,15,4"/>
                <CheckBox Content="SFX hooks" IsChecked="{Binding Project.Options.AddSoundEffects}" Margin="0,4,0,4"/>
              </WrapPanel>

              <TextBlock Text="Each chapter is scripted into the requested number of narration/image scenes. Missing media reuses the nearest real visual — no black empty frames." Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <WrapPanel><Button Style="{StaticResource PrimaryButton}" Command="{Binding GeneratePlanCommand}" Content="1. Generate project"/><Button Style="{StaticResource SecondaryButton}" Command="{Binding ContinueWritingCommand}" Content="Resume writing"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding RunPipelineCommand}" Content="2. Build video"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueTtsCommand}" Content="Continue TTS" IsEnabled="{Binding WaitingForTtsContinue}" ToolTip="Choose your voice manually in Clipchamp, then click here to continue narration and export."/></WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Project plan" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Every completed chapter is saved immediately. ZeroVideo also saves the project's ChatGPT conversation and returns to the same chat after restart." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Chapters}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/><DataGridTextColumn Header="Chapter" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="3*"/><DataGridTextColumn Header="Seconds" Binding="{Binding TargetSeconds}" Width="75"/><DataGridTextColumn Header="Scenes" Binding="{Binding Scenes.Count}" Width="65"/></DataGrid.Columns>
              </DataGrid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0"/>
            </Grid>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Automation Shorts">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Automation Shorts" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Paste a link or idea into each row. Check multiple rows, use Check All or Delete Checked to manage the queue. Only rows are deleted, not MP4s, PNGs or project folders. Video automation still runs sequentially." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddShortRowCommand}" Content="+ Add row"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveShortRowCommand}" Content="Remove last row"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding CheckAllShortsCommand}" Content="Check All"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCheckedShortsCommand}"
                          Content="Delete Checked" ToolTip="Delete only checked queue rows, never saved images, videos or project files."/>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartShortsCommand}" Content="Start automation"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResumeShortsCommand}"
                          Content="Resume Unfinished" ToolTip="Continue previously saved scripts, images, audio and unfinished video jobs."/>
                </WrapPanel>
                <TextBlock Text="{Binding ShortsRecoveryStatus}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding ShortQueue}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Use" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="Select this row for Check All / Delete Checked; does not change the automation run order."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Link / text idea" Binding="{Binding Idea, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Shorts settings" FontSize="21" FontWeight="SemiBold"/>
                <Label Content="VIDEO LENGTH (MIN)" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding ShortDurations}" SelectedItem="{Binding ShortDuration, Mode=TwoWay}"/>
                <TextBlock Text="Format: 9:16 vertical" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Label Content="STORY / EDIT STYLE" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}"/>
                <StackPanel Style="{StaticResource ClipchampVoicePanel}">
                  <Label Content="CLIPCHAMP VOICE" Margin="0,8,0,0"/>
                  <ComboBox ItemsSource="{Binding ClipchampVoices}" SelectedItem="{Binding Project.Voice, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource LocalNarratorPanel}" Margin="0,8,0,0">
                  <Label Content="ACTIVE SAVED VOICE"/>
                  <TextBlock Text="{Binding ActiveNarrationVoiceName}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentHover}" TextWrapping="Wrap" Margin="5,2,0,0"/>
                  <TextBlock Text="Change the narrator in Voice Studio. Clipchamp is hidden while local narration is selected."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="5,5,0,0"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="Output options" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox Content="Generate missing scene visuals" IsChecked="{Binding Project.Options.GenerateMissingVisuals}" Margin="0,7,0,0"/>
                <TextBlock Text="IMAGE GENERATION ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,3"/>
                <ComboBox ItemsSource="{Binding ImageGenerationEngines}"
                          SelectedItem="{Binding Settings.ImageGenerationEngine, Mode=TwoWay}"
                          ToolTip="ChatGPT remains default; Local ComfyUI requires installation; Hybrid provides fallback."/>
                <Label Content="HOW MANY CHAPTERS"/>
                <TextBox Text="{Binding Project.Options.HowManyChapters, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="IMAGES PER CHAPTER"/>
                <TextBox Text="{Binding Project.Options.ImagesPerChapter, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="SAFETY TOTAL IMAGE CAP"/>
                <TextBox Text="{Binding Project.Options.MaxGeneratedVisuals, UpdateSourceTrigger=LostFocus}"/>
                <CheckBox Content=".SRT captions" IsChecked="{Binding Project.Options.GenerateCaptions}" Margin="0,8,0,0"/>
                <CheckBox Content="Bold in-video captions (9:16)" IsChecked="{Binding Project.Options.BurnInBoldCaptions}" Margin="0,5,0,0" ToolTip="Slightly smaller all-white outlined text. Audio-pause-aware timing; word-level matching is approximate. Adds an FFmpeg render pass."/>
                <CheckBox Content="Visual motion" IsChecked="{Binding Project.Options.AddMotion}"/>
                <CheckBox Content="Subtle image animation (4-second gentle loops)" IsChecked="{Binding Project.Options.SubtleImageAnimation}"
                          ToolTip="4-second seamless gentle zoom/drift and light movement, automatically repeated for full narration length. No GPU model downloads."/>
                <TextBlock Text="ANIMATION ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,3"/>
                <ComboBox ItemsSource="{Binding AiImageAnimationEngines}"
                          SelectedItem="{Binding Settings.AiImageAnimationEngine, Mode=TwoWay}"
                          ToolTip="Off = still image, FFmpeg = camera motion, LivePortrait = subtle facial animation with fallback."/>
                <CheckBox Content="Music" IsChecked="{Binding Project.Options.AddBackgroundMusic}"/>
                <CheckBox Content="SFX hooks" IsChecked="{Binding Project.Options.AddSoundEffects}"/>
                <Button Style="{StaticResource ClipchampSecondaryButton}" Command="{Binding ContinueTtsCommand}" Content="Continue TTS" IsEnabled="{Binding WaitingForTtsContinue}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Thumbnail" FontWeight="SemiBold"/>
                <TextBlock Text="Creates a title-specific vertical cover saved as thumbnail.png in each project folder." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Separator Margin="0,12"/>
                <TextBlock Text="Publishing" FontWeight="SemiBold"/>
                <TextBlock Text="TikTok browser publishing is available in the Publishing tab. YouTube publishing is disabled for now; YouTube metadata is still generated." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Long Form Automation">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,7,4,4">
            <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                    Command="{Binding StopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Cancel the active operation; saved work is retained and can be resumed."/>
            <Button Style="{StaticResource SecondaryButton}" Content="Force Stop"
                    Command="{Binding ForceStopJobCommand}" IsEnabled="{Binding JobRunning}"
                    ToolTip="Emergency stop: cancel the job, interrupt local generation and terminate only ZeroVideo-owned automation processes."/>
            <TextBlock Text="{Binding JobControlStatus}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="510" ToolTip="{Binding JobControlStatus}"/>
          </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Long Form Automation" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Paste a link or idea into each row. Check multiple rows, use Check All or Delete Checked to manage the queue. Videos run sequentially at 16:9. Deleting queue rows does not delete rendered files or project folders." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddLongFormRowCommand}" Content="+ Add row"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveLongFormRowCommand}" Content="Remove last row"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding CheckAllLongFormCommand}" Content="Check All"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCheckedLongFormCommand}"
                          Content="Delete Checked" ToolTip="Delete only checked queue rows, never saved images, videos or project files."/>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartLongFormCommand}" Content="Start automation"/>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResumeLongFormCommand}"
                          Content="Resume Unfinished" ToolTip="Continue previously saved scripts, images, audio and unfinished video jobs."/>
                </WrapPanel>
                <TextBlock Text="{Binding LongFormRecoveryStatus}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding LongFormQueue}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Use" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="Select this row for Check All / Delete Checked; does not change the automation run order."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Link / text idea" Binding="{Binding Idea, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Long Form settings" FontSize="21" FontWeight="SemiBold"/>
                <Label Content="VIDEO LENGTH (MIN)" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding LongFormDurations}" SelectedItem="{Binding LongFormDuration, Mode=TwoWay}"/>
                <TextBlock Text="Format: 16:9 widescreen (1920×1080 output)" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Label Content="STORY / EDIT STYLE" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style, Mode=TwoWay}"/>
                <StackPanel Style="{StaticResource ClipchampVoicePanel}">
                  <Label Content="CLIPCHAMP VOICE" Margin="0,8,0,0"/>
                  <ComboBox ItemsSource="{Binding ClipchampVoices}" SelectedItem="{Binding Project.Voice, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource LocalNarratorPanel}" Margin="0,8,0,0">
                  <Label Content="ACTIVE SAVED VOICE"/>
                  <TextBlock Text="{Binding ActiveNarrationVoiceName}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentHover}" TextWrapping="Wrap" Margin="5,2,0,0"/>
                  <TextBlock Text="Change the narrator in Voice Studio. Clipchamp is hidden while local narration is selected."
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="5,5,0,0"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="Output options" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox Content="Generate missing scene visuals" IsChecked="{Binding Project.Options.GenerateMissingVisuals}" Margin="0,7,0,0"/>
                <TextBlock Text="IMAGE GENERATION ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,3"/>
                <ComboBox ItemsSource="{Binding ImageGenerationEngines}"
                          SelectedItem="{Binding Settings.ImageGenerationEngine, Mode=TwoWay}"
                          ToolTip="ChatGPT remains default; Local ComfyUI requires installation; Hybrid provides fallback."/>
                <Label Content="HOW MANY CHAPTERS"/>
                <TextBox Text="{Binding Project.Options.HowManyChapters, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="IMAGES PER CHAPTER"/>
                <TextBox Text="{Binding Project.Options.ImagesPerChapter, UpdateSourceTrigger=LostFocus}"/>
                <Label Content="SAFETY TOTAL IMAGE CAP"/>
                <TextBox Text="{Binding Project.Options.MaxGeneratedVisuals, UpdateSourceTrigger=LostFocus}"/>
                <CheckBox Content=".SRT captions" IsChecked="{Binding Project.Options.GenerateCaptions}" Margin="0,8,0,0"/>
                <TextBlock Text="16:9 exports retain SRT captions. Bold burned-in captions currently apply only to 9:16 videos; the existing renderer is unchanged."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,6"/>
                <CheckBox Content="Visual motion" IsChecked="{Binding Project.Options.AddMotion}"/>
                <CheckBox Content="Subtle image animation (4-second gentle loops)" IsChecked="{Binding Project.Options.SubtleImageAnimation}"
                          ToolTip="4-second seamless gentle zoom/drift and light movement, automatically repeated for full narration length. No GPU model downloads."/>
                <TextBlock Text="ANIMATION ENGINE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,3"/>
                <ComboBox ItemsSource="{Binding AiImageAnimationEngines}"
                          SelectedItem="{Binding Settings.AiImageAnimationEngine, Mode=TwoWay}"
