<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZeroVideo</AssemblyName>
    <RootNamespace>ZeroVideo.App</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\omnivoice_worker.py" />
    <EmbeddedResource Include="Resources\zerovideo_idle_driver.py" />
    <EmbeddedResource Include="Resources\zerovideo_idle_driver_init.py" />
    <EmbeddedResource Include="Resources\liveportrait_import_probe.py" />
    <EmbeddedResource Include="Resources\liveportrait_face_probe.py" />
    <EmbeddedResource Include="Resources\liveportrait_onnx_probe.py" />
    <EmbeddedResource Include="Resources\pulid_import_probe.py" />
    <EmbeddedResource Include="Resources\pulid_flux_compat.py" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\profiles\automation.default.json" Link="profiles\automation.default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
